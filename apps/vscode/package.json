{
  "name": "liftoff",
  "displayName": "LiftOff",
  "description": "Change your dev database or the schema-model files, pull the change into git, and let the pipeline write and run the migration.",
  "version": "0.1.0",
  "publisher": "liftoff",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanderstad/liftoff.git"
  },
  "homepage": "https://github.com/sanderstad/liftoff",
  "bugs": {
    "url": "https://github.com/sanderstad/liftoff/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "database",
    "migrations",
    "postgresql",
    "sql server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/liftoff.toml",
    "workspaceContains:**/flyway.toml",
    "workspaceContains:**/flyway.conf"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liftoff",
          "title": "LiftOff",
          "icon": "media/liftoff.svg"
        }
      ]
    },
    "views": {
      "liftoff": [
        {
          "id": "liftoff.environments",
          "name": "Environments"
        },
        {
          "id": "liftoff.model",
          "name": "Schema Model"
        },
        {
          "id": "liftoff.compare",
          "name": "Compare",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "liftoff.environments",
        "when": "liftoff.flywayProject",
        "contents": "This folder has a Flyway project. Import it to use it with LiftOff: a few questions, and your Flyway files stay as they are.\n[Import Flyway Project](command:liftoff.importFlyway)\nOr start fresh: [Create LiftOff Project](command:liftoff.newProject)"
      },
      {
        "view": "liftoff.environments",
        "when": "!liftoff.flywayProject",
        "contents": "There is no LiftOff project in this workspace yet.\n[Create LiftOff Project](command:liftoff.newProject)\nComing from Flyway? [Import Flyway Project](command:liftoff.importFlyway)"
      },
      {
        "view": "liftoff.model",
        "contents": "See what the dev database has that the schema-model files do not, and pull it in to commit.\n[Compare with Dev](command:liftoff.model.compare)\nEdited the files by hand? [Check Schema Model](command:liftoff.model.check)"
      },
      {
        "view": "liftoff.compare",
        "contents": "Compare the schema of any two: environments, the schema model, what the migrations build, a snapshot, or any database by URL. Then open the script, write a migration, or apply it.\n[Compare\u2026](command:liftoff.compare)\n[Save a Snapshot\u2026](command:liftoff.snapshot)"
      }
    ],
    "commands": [
      {
        "command": "liftoff.refresh",
        "title": "Refresh",
        "category": "LiftOff",
        "icon": "$(refresh)"
      },
      {
        "command": "liftoff.migrate",
        "title": "Run Pending Migrations",
        "category": "LiftOff",
        "icon": "$(play)"
      },
      {
        "command": "liftoff.validate",
        "title": "Validate",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.dryRun",
        "title": "Show the SQL That Would Run",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.checkDrift",
        "title": "Check for Drift",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.testConnection",
        "title": "Test Connection",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.showLog",
        "title": "Show Log",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.model.compare",
        "title": "Compare Dev with Schema Model",
        "category": "LiftOff",
        "icon": "$(refresh)"
      },
      {
        "command": "liftoff.model.open",
        "title": "Show the Difference",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.model.pull",
        "title": "Pull into Schema Model",
        "category": "LiftOff",
        "icon": "$(arrow-down)"
      },
      {
        "command": "liftoff.model.pullAll",
        "title": "Pull All into Schema Model",
        "category": "LiftOff",
        "icon": "$(cloud-download)"
      },
      {
        "command": "liftoff.model.check",
        "title": "Check Schema Model",
        "category": "LiftOff",
        "icon": "$(check-all)"
      },
      {
        "command": "liftoff.model.generate",
        "title": "Generate Migration from Schema Model",
        "category": "LiftOff",
        "icon": "$(file-code)"
      },
      {
        "command": "liftoff.pipeline",
        "title": "Set Up Pipeline",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.importFlyway",
        "title": "Import Flyway Project",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.settings",
        "title": "Project Settings",
        "category": "LiftOff",
        "icon": "$(gear)"
      },
      {
        "command": "liftoff.editEnvironment",
        "title": "Edit Environment",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.newProject",
        "title": "New Project",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.runOnly",
        "title": "Run This Script Only",
        "category": "LiftOff",
        "icon": "$(play)"
      },
      {
        "command": "liftoff.compare",
        "title": "Compare\u2026",
        "category": "LiftOff",
        "icon": "$(git-compare)"
      },
      {
        "command": "liftoff.compare.again",
        "title": "Compare Again",
        "category": "LiftOff",
        "icon": "$(refresh)"
      },
      {
        "command": "liftoff.compare.swap",
        "title": "Swap Source and Target",
        "category": "LiftOff",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "liftoff.compare.open",
        "title": "Show the Difference",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.compare.script",
        "title": "Open the Sync Script",
        "category": "LiftOff",
        "icon": "$(file-code)"
      },
      {
        "command": "liftoff.compare.migration",
        "title": "Write the Differences as a Migration",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.compare.apply",
        "title": "Apply to the Target",
        "category": "LiftOff",
        "icon": "$(play)"
      },
      {
        "command": "liftoff.snapshot",
        "title": "Save a Snapshot\u2026",
        "category": "LiftOff",
        "icon": "$(device-camera)"
      },
      {
        "command": "liftoff.rebaseline",
        "title": "Rebaseline Project\u2026",
        "category": "LiftOff"
      },
      {
        "command": "liftoff.adopt",
        "title": "Adopt Existing Database\u2026",
        "category": "LiftOff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "liftoff.refresh",
          "when": "view == liftoff.environments",
          "group": "navigation"
        },
        {
          "command": "liftoff.model.compare",
          "when": "view == liftoff.model",
          "group": "navigation@1"
        },
        {
          "command": "liftoff.model.pullAll",
          "when": "view == liftoff.model",
          "group": "navigation@2"
        },
        {
          "command": "liftoff.model.check",
          "when": "view == liftoff.model",
          "group": "navigation@3"
        },
        {
          "command": "liftoff.model.generate",
          "when": "view == liftoff.model",
          "group": "1_model@1"
        },
        {
          "command": "liftoff.pipeline",
          "when": "view == liftoff.model",
          "group": "1_model@2"
        },
        {
          "command": "liftoff.settings",
          "when": "view == liftoff.environments && liftoff.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "liftoff.compare",
          "when": "view == liftoff.compare",
          "group": "navigation@1"
        },
        {
          "command": "liftoff.compare.again",
          "when": "view == liftoff.compare",
          "group": "navigation@2"
        },
        {
          "command": "liftoff.compare.swap",
          "when": "view == liftoff.compare",
          "group": "navigation@3"
        },
        {
          "command": "liftoff.compare.script",
          "when": "view == liftoff.compare && liftoff.compared",
          "group": "navigation@4"
        },
        {
          "command": "liftoff.compare.apply",
          "when": "view == liftoff.compare && liftoff.compared",
          "group": "1_act@1"
        },
        {
          "command": "liftoff.compare.migration",
          "when": "view == liftoff.compare && liftoff.compared",
          "group": "1_act@2"
        },
        {
          "command": "liftoff.snapshot",
          "when": "view == liftoff.compare",
          "group": "2_snapshot@1"
        }
      ],
      "view/item/context": [
        {
          "command": "liftoff.migrate",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "liftoff.migrate",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "1_run@1"
        },
        {
          "command": "liftoff.dryRun",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "1_run@2"
        },
        {
          "command": "liftoff.validate",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "2_check@1"
        },
        {
          "command": "liftoff.checkDrift",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "2_check@2"
        },
        {
          "command": "liftoff.testConnection",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "2_check@3"
        },
        {
          "command": "liftoff.model.pull",
          "when": "view == liftoff.model && viewItem == modelChange",
          "group": "inline"
        },
        {
          "command": "liftoff.model.pull",
          "when": "view == liftoff.model && viewItem == modelChange",
          "group": "1_pull@1"
        },
        {
          "command": "liftoff.model.open",
          "when": "view == liftoff.model && viewItem == modelChange",
          "group": "1_pull@2"
        },
        {
          "command": "liftoff.editEnvironment",
          "when": "view == liftoff.environments && viewItem == environment",
          "group": "3_edit@1"
        },
        {
          "command": "liftoff.runOnly",
          "when": "view == liftoff.environments && viewItem == migration.pickable",
          "group": "1_run@1"
        },
        {
          "command": "liftoff.adopt",
          "when": "view == liftoff.environments && viewItem == environment && liftoff.noScripts",
          "group": "3_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "liftoff.model.open",
          "when": "false"
        },
        {
          "command": "liftoff.model.pull",
          "when": "false"
        },
        {
          "command": "liftoff.editEnvironment",
          "when": "false"
        },
        {
          "command": "liftoff.runOnly",
          "when": "false"
        },
        {
          "command": "liftoff.compare.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LiftOff",
      "properties": {
        "liftoff.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `liftoff` program. Leave empty to use the one that comes with the extension, or `liftoff` on your PATH."
        },
        "liftoff.devEnvironment": {
          "type": "string",
          "default": "",
          "markdownDescription": "The environment you change by hand (your dev database). Leave empty to use the one with role `dev` in liftoff.toml."
        },
        "liftoff.checkModelOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Check that the schema model builds every time a file in `schema-model/` is saved (uses the scratch database)."
        },
        "liftoff.generateUndo": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also write the matching undo script (`U\u2026`) when generating a migration from the schema model."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node --test \"out/test/*.test.js\"",
    "test:vscode": "npm run build && node out/test-vscode/run.js",
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "package": "npm run build && npm run bundle-cli && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "~5.8.0"
  }
}
