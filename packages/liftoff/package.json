{
  "name": "liftoff",
  "version": "0.2.1",
  "description": "Database migrations for PostgreSQL and SQL Server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanderstad/liftoff.git"
  },
  "homepage": "https://github.com/sanderstad/liftoff",
  "bugs": {
    "url": "https://github.com/sanderstad/liftoff/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "liftoff": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "pg": "^8.23.1",
    "smol-toml": "^1.9.1",
    "tedious": "^20.3.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
